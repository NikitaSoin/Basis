# Отдача уже собранного фронта Basis через nginx.
#
# 🔴 УСТОЙЧИВ К ДВУМ КОНТЕКСТАМ СБОРКИ. Раньше здесь было `COPY build …`, и это работает
# ТОЛЬКО если контекст — папка frontend/Basis. Если сборщик запущен из корня репозитория
# (а какой контекст задан в панели Timeweb, из кода не видно), путь ./build не
# существует, и сборка падает на первом шаге — БЕЗ внятного лога, что и наблюдалось
# 2026-08-03: «деплой не проходит, логи пустые».
# Поэтому копируем контекст целиком и дальше сами находим папку сборки — работает и из
# корня, и из папки приложения.
#
# 🔴 ЧТО ЭТОТ ОБРАЗ НЕ ДЕЛАЕТ: он НЕ пересобирает фронт. Собранное лежит в репозитории.
# Причина — сборка на сервере тяжёлая (webpack + три генератора на ~8800 файлов) и её
# убивает по памяти; исторически от неё уже уходили по этой же причине.
# Плата за это: генераторы перестают ходить в боевой API при деплое, и снапшоты (свежие
# отчёты, справедливая цена, новости, прогноз ЦБ) замирают на закоммиченном. Обновляются
# при локальной пересборке с коммитом.
FROM nginx:alpine

# .dockerignore в корне репозитория убирает из контекста историю git, зависимости и
# документацию — без него сюда приезжало 924 МБ.
COPY . /src

# Находим папку сборки независимо от контекста и проверяем, что она НЕ ОБРЕЗАННАЯ.
# 🔴 Пороги те же, что в правиле защиты SEO-страниц (CLAUDE.md): голый `craco build`
# ужимает build/ с ~8800 файлов до ~31 и подменяет карту сайта заготовкой с одним
# адресом. Отдать такое на бой — молча потерять 8500 страниц. Пусть лучше упадёт сборка
# образа: пустой сайт хуже несостоявшегося деплоя.
RUN set -e; \
    if   [ -d /src/build ];                    then SRC=/src/build; \
    elif [ -d /src/frontend/Basis/build ];     then SRC=/src/frontend/Basis/build; \
    else echo "НЕ НАЙДЕНА папка build ни в корне контекста, ни в frontend/Basis"; exit 1; fi; \
    echo "Папка сборки: $SRC"; \
    FILES="$(find "$SRC" -name index.html | wc -l)"; \
    LOCS="$(grep -c '<loc>' "$SRC/sitemap.xml" 2>/dev/null || echo 0)"; \
    echo "Страниц: $FILES, адресов в карте: $LOCS"; \
    if [ "$FILES" -lt 5000 ]; then \
      echo "СБОРКА НЕПОЛНАЯ: страниц $FILES, ожидаем ~8800 — build/ затёрт голым craco build?"; \
      echo "Починить: cd frontend/Basis && CI=false npm run build, затем закоммитить build/"; \
      exit 1; fi; \
    if [ "$LOCS" -lt 1000 ]; then \
      echo "КАРТА САЙТА ПОДМЕНЕНА: адресов $LOCS, ожидаем ~4700 (заготовка из public/?)"; \
      exit 1; fi; \
    rm -rf /usr/share/nginx/html; \
    cp -r "$SRC" /usr/share/nginx/html; \
    if   [ -f /src/nginx.conf ];                then cp /src/nginx.conf /etc/nginx/conf.d/default.conf; \
    elif [ -f /src/frontend/Basis/nginx.conf ]; then cp /src/frontend/Basis/nginx.conf /etc/nginx/conf.d/default.conf; \
    else echo "nginx.conf не найден — остаётся конфиг по умолчанию"; fi; \
    rm -rf /src

EXPOSE 80
