# Отдача фронта Basis через nginx (переход с Caddy — поддержка Timeweb: «возможности
# настроить Caddy в приложении нет, рекомендуем деплой через Docker»).
#
# 🔴 ЧТО МЕНЯЕТСЯ ПО СРАВНЕНИЮ С ТЕКУЩИМ ДЕПЛОЕМ. Сейчас Timeweb СОБИРАЕТ фронт у себя —
# проверено 2026-08-02 по хэшам: на бою main.0b616c3b.js, в коммите main.7e28aa41.js.
# Побочный, но важный эффект этой сборки: на каждом деплое заново выполняются наши
# генераторы, а они ходят в боевой API за свежими данными (разборы отчётов, справедливая
# цена, новости, прогноз ЦБ, значения макропоказателей). Именно поэтому новый отчёт
# компании появляется на сайте сам, без ручной пересборки.
#
# Здесь образ ОТДАЁТ УЖЕ СОБРАННОЕ (COPY build) — так исторически ушли от сборки на
# сервере, она падала по памяти, когда бандл вырос. Значит, после перехода:
#   • деплой станет быстрее и предсказуемее;
#   • но снапшоты перестанут обновляться сами — они замрут на том, что закоммичено.
# Это осознанный размен, а не недосмотр: обновление снапшотов переносится в регулярную
# локальную пересборку с коммитом.
FROM nginx:alpine

COPY build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 🔴 ПРЕДОХРАНИТЕЛЬ. Папка build/ живёт в общей рабочей копии, и параллельная сессия,
# запустившая голый `craco build`, ужимает её с 8827 файлов до 31 (проверено дважды за
# час 2026-08-02): CRA копирует public/ и НЕ запускает наши генераторы. Закоммить такое —
# значит выложить на бой сайт без 8500 страниц, причём коммит выглядит как обычная
# пересборка. Пусть лучше упадёт сборка образа, чем выкатится пустой сайт.
RUN test "$(find /usr/share/nginx/html -name index.html | wc -l)" -gt 5000 \
      || (echo "СБОРКА НЕПОЛНАЯ: страниц меньше 5000 — build/ затёрт голым craco build?" \
          && echo "Пересоберите: cd frontend/Basis && CI=false npm run build" && exit 1) \
 && test "$(grep -c '<loc>' /usr/share/nginx/html/sitemap.xml)" -gt 1000 \
      || (echo "КАРТА САЙТА ПОДМЕНЕНА: адресов меньше 1000 (заготовка из public/?)" && exit 1)

EXPOSE 80
