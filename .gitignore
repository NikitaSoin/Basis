# 🔴 СОБРАННЫЙ ФРОНТ — НЕ КОММИТИМ (2026-08-03, после того как деплой встал совсем).
# Timeweb собирает фронт САМ (`npm run build` на своей стороне) — доказано тем, что бандл
# на бою main.ab65c6bf.js, а в коммите лежал main.e73ecb3d.js. То есть закоммиченная
# сборка на сайт не попадала НИКОГДА: SEO-страницы на бою — результат сборки Timeweb.
# А цена была высокой: 550 коммитов сборки раздули репозиторий до 639 МБ и 15 340 файлов,
# клон перестал укладываться в лимиты сборщика — деплой падал ДО запуска npm.
# Побочно это закрывает целый класс аварий: раз сборки в репозитории нет, испортить
# боевые SEO-страницы неудачным локальным билдом больше нельзя в принципе.
frontend/Basis/build/

# Исследовательские исходники и макеты — НЕ в репозиторий (раздувают клон/образ; рантайм не использует)
backend/companies/*/sources/
docs/*.zip
docs/*.pdf

# Кэш Natural Earth admin-1 (39 МБ) — качается скриптом geo_svo_rebuild_regions.py по нужде
backend/scripts/.ne_admin1_cache.geojson
# Кэш границ OSM/Overpass — качается geo_svo_rebuild_regions.py по нужде
backend/scripts/.osm_admin4_cache.json
# Кэш контура суши Natural Earth — там же
backend/scripts/.ne_land_cache.geojson
# Кэш сырых таймлапсов ISW (~108 МБ) — качается geo_svo_fetch_real_history.py по нужде
backend/scripts/.real_history_cache/
